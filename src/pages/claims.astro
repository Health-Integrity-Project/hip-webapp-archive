---
import Base from '../layouts/Base.astro';
import { getAllClaims } from '../lib/fetchClaimEvidence';
import type { Claim } from '../lib/types';
import { buildOrganizationSchema, buildWebSiteSchema } from '../lib/structuredData';

const claims = await getAllClaims();
const orgSchema = buildOrganizationSchema();
const siteSchema = buildWebSiteSchema();

function getEvidenceStatusColor(status: string): string {
  const colors: Record<string, string> = {
    'Awaiting Evidence': 'bg-gray-600',
    'Evidence Supports': 'bg-green-500',
    'Evidence Disproves': 'bg-red-500',
    'Inconclusive': 'bg-amber-400',
  };
  return colors[status] ?? 'bg-gray-600';
}

const LABEL_COLORS: Record<string, string> = {
  // reproductive / lifecycle — teal
  pregnancy: 'border-teal-500 text-teal-700',
  fertility: 'border-teal-500 text-teal-700',
  contraception: 'border-teal-500 text-teal-700',
  menstruation: 'border-teal-500 text-teal-700',
  perimenopause: 'border-teal-500 text-teal-700',
  menopause: 'border-teal-500 text-teal-700',
  postmenopause: 'border-teal-500 text-teal-700',
  breastfeeding: 'border-teal-500 text-teal-700',
  'sexual-health': 'border-teal-500 text-teal-700',
  'pelvic-floor': 'border-teal-500 text-teal-700',
  // nutrition — green
  nutrition: 'border-green-500 text-green-700',
  diet: 'border-green-500 text-green-700',
  supplements: 'border-green-500 text-green-700',
  hydration: 'border-green-500 text-green-700',
  // physical — blue
  fitness: 'border-blue-500 text-blue-700',
  'body-composition': 'border-blue-500 text-blue-700',
  exercise: 'border-blue-500 text-blue-700',
  'weight-management': 'border-blue-500 text-blue-700',
  sleep: 'border-blue-500 text-blue-700',
  energy: 'border-blue-500 text-blue-700',
  // body systems — purple
  'bone-health': 'border-purple-500 text-purple-700',
  'heart-health': 'border-purple-500 text-purple-700',
  'hormone-health': 'border-purple-500 text-purple-700',
  'gut-health': 'border-purple-500 text-purple-700',
  'skin-health': 'border-purple-500 text-purple-700',
  immunity: 'border-purple-500 text-purple-700',
  inflammation: 'border-purple-500 text-purple-700',
  // mental — indigo
  'mental-health': 'border-indigo-500 text-indigo-700',
  'cognitive-health': 'border-indigo-500 text-indigo-700',
  stress: 'border-indigo-500 text-indigo-700',
  mood: 'border-indigo-500 text-indigo-700',
  anxiety: 'border-indigo-500 text-indigo-700',
  adhd: 'border-indigo-500 text-indigo-700',
  autism: 'border-indigo-500 text-indigo-700',
  depression: 'border-indigo-500 text-indigo-700',
};

function getLabelColor(value: string): string {
  return LABEL_COLORS[value] ?? 'border-slate-400 text-slate-600';
}

function getLabelDisplay(value: string): string {
  return value
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');
}

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('en-US', { month: 'numeric', day: 'numeric', year: 'numeric' });
}
---

<Base
  title="Health Claims | The Health Integrity Project"
  description={`Archive of ${claims.length} health claims with expert-reviewed scientific evidence. See what peer-reviewed research says about nutrition, supplements, exercise, and medical treatments.`}
  canonicalUrl="/claims"
  ogType="website"
  jsonLd={[orgSchema, siteSchema]}
>
  <h1 class="text-3xl font-bold mb-4">The Health Integrity Project</h1>
  <p class="text-muted-foreground mb-8 max-w-2xl">
    Expert-reviewed evidence for health claims that matter to you. This is a read-only archive.
  </p>

  {/* Live app CTA */}
  <div class="mb-10 rounded-2xl bg-gradient-to-r from-primary to-teal-600 p-6 sm:p-8 shadow-lg">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white">Vote, comment &amp; request expert reviews</h2>
        <p class="mt-1 text-white/90 max-w-xl">
          The full interactive experience lives in the app. Submit new claims, join the discussion, and follow reviews in real time.
        </p>
      </div>
      <a
        href="https://healthintegrityproject.org"
        target="_blank"
        rel="noopener"
        class="shrink-0 inline-flex items-center justify-center gap-2 rounded-xl bg-white px-6 py-3 text-base font-semibold text-primary shadow-md hover:bg-white/90 transition-colors"
      >
        Open Live App
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>

  <section>
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-6">
      <h2 class="text-xl font-semibold text-foreground">All Claims ({claims.length})</h2>
    </div>

    {/* Search */}
    <div class="mb-6">
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" />
          <path stroke-linecap="round" d="M21 21l-4.35-4.35" />
        </svg>
        <input
          type="search"
          id="claim-search"
          placeholder="Search claims by title, category, or topic…"
          autocomplete="off"
          class="w-full rounded-xl border border-border bg-card pl-11 pr-4 py-3 text-base text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary"
        />
      </div>
      <p id="search-meta" class="mt-2 text-sm text-muted-foreground">
        Showing all {claims.length} archived claims.
        <a href="https://healthintegrityproject.org" target="_blank" rel="noopener" class="text-primary font-medium hover:underline">Search the full app →</a>
      </p>
      <p id="search-empty" class="hidden mt-4 rounded-lg border border-border bg-card/50 p-4 text-sm text-muted-foreground">
        No archived claims match <span id="search-empty-term" class="font-medium text-foreground"></span>.
        Try the <a href="https://healthintegrityproject.org" target="_blank" rel="noopener" class="text-primary font-medium hover:underline">full app search →</a>
      </p>
    </div>

    <ul id="claims-list" class="space-y-4">
      {claims.map((claim: Claim) => (
        <li data-search={`${claim.title} ${claim.broad_category ?? ''} ${(claim.labels ?? []).map(getLabelDisplay).join(' ')} ${(claim.labels ?? []).join(' ')}`.toLowerCase()}>
          <a
            href={`/claims/${claim.slug}/evidence`}
            class="block rounded-lg border border-border bg-card/50 overflow-hidden hover:shadow-lg transition-shadow"
          >
            {/* Evidence status banner */}
            {claim.evidence_status && (
              <div class={`${getEvidenceStatusColor(claim.evidence_status)} px-4 py-2 flex items-center gap-2 rounded-t-lg`}>
                <span class="font-semibold text-sm uppercase tracking-wide text-white">
                  {claim.evidence_status}
                </span>
                <svg class="w-4 h-4 text-white/80" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10" />
                  <line x1="12" y1="8" x2="12" y2="12" />
                  <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
              </div>
            )}

            <div class="px-4 pt-3 pb-4">
              {/* Category + labels */}
              <div class="flex flex-wrap gap-2 mb-3">
                {claim.broad_category && (
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full border border-border text-foreground bg-background">
                    {claim.broad_category}
                  </span>
                )}
                {(claim.labels ?? []).map((label: string) => (
                  <span class={`text-xs font-medium border rounded-full px-2 py-0.5 ${getLabelColor(label)}`}>
                    {getLabelDisplay(label)}
                  </span>
                ))}
              </div>

              {/* Claim title + paper count */}
              <p class="font-bold text-lg text-foreground mb-4">
                {claim.title}
                {claim.publication_count > 0 && (
                  <span class="ml-3 text-sm font-normal text-muted-foreground">
                    {claim.publication_count} paper{claim.publication_count === 1 ? '' : 's'}
                  </span>
                )}
              </p>

              {/* Action buttons */}
              <div class="border-t border-border pt-3 space-y-2">
                <div class="flex flex-wrap gap-2">
                  {claim.publication_count > 0 && (
                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md bg-primary text-primary-foreground text-sm font-medium shadow-md">
                      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.75 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                      </svg>
                      View Evidence
                    </span>
                  )}
                </div>

                {/* Date */}
                <div class="flex items-center justify-end gap-2">
                  <div class="flex items-center gap-1 text-xs text-muted-foreground">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                      <line x1="16" y1="2" x2="16" y2="6" />
                      <line x1="8" y1="2" x2="8" y2="6" />
                      <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>
                    <span>Submitted {formatDate(claim.created_at)}</span>
                  </div>
                </div>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script is:inline define:vars={{ total: claims.length }}>
    const input = document.getElementById('claim-search');
    const items = Array.from(document.querySelectorAll('#claims-list > li'));
    const meta = document.getElementById('search-meta');
    const empty = document.getElementById('search-empty');
    const emptyTerm = document.getElementById('search-empty-term');

    function filter() {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        items.forEach((li) => (li.hidden = false));
        meta.hidden = false;
        meta.firstChild.textContent = `Showing all ${total} archived claims. `;
        empty.classList.add('hidden');
        return;
      }
      let shown = 0;
      items.forEach((li) => {
        const match = (li.dataset.search || '').includes(q);
        li.hidden = !match;
        if (match) shown++;
      });
      meta.hidden = false;
      meta.firstChild.textContent = `Showing ${shown} of ${total} archived claims. `;
      if (shown === 0) {
        empty.classList.remove('hidden');
        emptyTerm.textContent = `"${input.value.trim()}"`;
      } else {
        empty.classList.add('hidden');
      }
    }

    input?.addEventListener('input', filter);
  </script>
</Base>
