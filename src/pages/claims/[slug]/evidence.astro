---
import Base from '../../../layouts/Base.astro';
import PublicationList from '../../../components/PublicationList.astro';
import { getAllClaimSlugs, getClaimEvidence } from '../../../lib/fetchClaimEvidence';
import { buildOrganizationSchema, buildClaimReviewSchema, buildBreadcrumbSchema, buildPublicationSchema, buildPersonSchema } from '../../../lib/structuredData';

export async function getStaticPaths() {
  const slugs = await getAllClaimSlugs();
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const claim = await getClaimEvidence(slug);

if (!claim) return Astro.redirect('/');

const appUrl = `https://healthintegrityproject.org/claims/${slug}/evidence`;
const canonicalClaimUrl = `https://open.healthintegrityproject.org/claims/${slug}/evidence`;
const claimReviewSchema = buildClaimReviewSchema(claim, canonicalClaimUrl);
const breadcrumbSchema = buildBreadcrumbSchema(claim.title, canonicalClaimUrl);
const orgSchema = buildOrganizationSchema();
const publicationSchemas = claim.publications
  .map(buildPublicationSchema)
  .filter((s): s is Record<string, unknown> => s !== null);
const personSchemas = claim.experts
  .map(buildPersonSchema)
  .filter((s): s is Record<string, unknown> => s !== null);
const buildDate = new Date().toISOString().split('T')[0];

const pubCount = claim.publications.length;
const statusText = claim.evidence_status ?? 'Reviewed';
const descriptionBase = claim.description
  ? claim.description.slice(0, 120)
  : claim.title;
const pageDescription = `${statusText}: ${descriptionBase}. Backed by ${pubCount} scientific publication${pubCount !== 1 ? 's' : ''} reviewed by health experts.`;

const supporting = claim.publications.filter((p) => p.stance === 'supporting');
const contradicting = claim.publications.filter((p) => p.stance === 'contradicting');
const neutral = claim.publications.filter(
  (p) => p.stance === 'neutral' || p.stance === 'mixed' || !p.stance
);

function evidenceBadgeClass(status: string | null): string {
  switch (status) {
    case 'Evidence Supports':  return 'bg-teal-100 text-teal-800 border border-teal-300';
    case 'Evidence Disproves': return 'bg-orange-100 text-orange-800 border border-orange-300';
    case 'Inconclusive':       return 'bg-yellow-100 text-yellow-800 border border-yellow-300';
    default:                   return 'bg-gray-100 text-gray-700 border border-gray-300';
  }
}

---

<Base
  title={claim.title}
  description={pageDescription}
  canonicalUrl={`/claims/${slug}/evidence`}
  jsonLd={[orgSchema, claimReviewSchema, breadcrumbSchema, ...publicationSchemas, ...personSchemas]}
>
  <nav class="text-sm text-gray-500 mb-6">
    <a href="/" class="hover:text-gray-700 transition-colors">Archive</a>
    <span class="mx-2">›</span>
    <span class="text-gray-700">Evidence</span>
  </nav>

  {claim.evidence_status && (
    <span class={`inline-block px-3 py-1 rounded-full text-sm font-semibold mb-4 ${evidenceBadgeClass(claim.evidence_status)}`}>
      {claim.evidence_status}
    </span>
  )}

  <h1 class="text-2xl sm:text-3xl font-bold mb-4 leading-snug">{claim.title}</h1>

  {claim.description && (
    <p class="text-gray-600 mb-8 leading-relaxed max-w-3xl">{claim.description}</p>
  )}

  <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 mb-10 flex flex-col sm:flex-row sm:items-center gap-3">
    <p class="text-sm text-gray-600 flex-1">
      Static snapshot — vote, comment, and submit papers on the live app.
    </p>
    <a
      href={appUrl}
      class="inline-block px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium rounded-lg transition-colors whitespace-nowrap"
      target="_blank"
      rel="noopener noreferrer"
    >
      Open in Live App →
    </a>
  </div>

  {claim.publications.length === 0 ? (
    <div class="text-center py-16 text-gray-500 border border-gray-200 rounded-lg">
      No papers submitted for this claim yet.
    </div>
  ) : (
    <div class="space-y-12">
      {supporting.length > 0 && (
        <PublicationList
          publications={supporting}
          scores={claim.scores}
          experts={claim.experts}
          stanceColor="teal"
          label="Supporting Evidence"
          sectionId="supporting-content"
        />
      )}
      {contradicting.length > 0 && (
        <PublicationList
          publications={contradicting}
          scores={claim.scores}
          experts={claim.experts}
          stanceColor="orange"
          label="Contradicting Evidence"
          sectionId="contradicting-content"
        />
      )}
      {neutral.length > 0 && (
        <PublicationList
          publications={neutral}
          scores={claim.scores}
          experts={claim.experts}
          stanceColor="gray"
          label="Neutral / Mixed"
          sectionId="neutral-content"
        />
      )}
    </div>
  )}

  <p class="mt-16 text-xs text-gray-400 text-right">Snapshot built: {buildDate}</p>
</Base>
