---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
}

const { title, description, canonicalUrl, ogType = 'article' } = Astro.props;
const siteUrl = 'https://archive.healthintegrityproject.org';
const appUrl = 'https://healthintegrityproject.org';
const canonical = canonicalUrl ? `${siteUrl}${canonicalUrl}` : siteUrl;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | The Health Integrity Project</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta name="robots" content="index, follow" />
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <header class="sticky top-0 z-50 bg-primary/80 backdrop-blur-sm border-b border-white/10 px-6 py-3">
      <div class="max-w-4xl mx-auto flex items-center justify-between">
        <a
          href="/"
          class="flex items-center gap-3 text-white hover:text-accent transition-colors font-semibold text-lg"
          aria-label="The Health Integrity Project home"
        >
          The Health Integrity Project
        </a>

        <nav class="hidden md:flex items-center gap-6 text-sm font-bold text-white">
          <a href="/" class="hover:text-white/80 transition-colors">Claims</a>
        </nav>

        <a
          href={appUrl}
          class="text-sm text-white/80 hover:text-white transition-colors border border-white/30 hover:bg-white/20 px-3 py-1.5 rounded-md"
          target="_blank"
          rel="noopener"
        >
          Live App →
        </a>
      </div>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12">
      <slot />
    </main>

    <footer class="mt-12 border-t border-border bg-background/60 px-6 py-6">
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-3">
        <div class="flex flex-col items-center md:items-start gap-1">
          <p class="text-sm text-muted-foreground">© {year} Health Integrity Project. All rights reserved.</p>
          <p class="text-xs text-muted-foreground">
            Archive rebuilt daily from{' '}
            <a href={appUrl} class="text-primary hover:underline">Evidence Decoded</a>.
          </p>
        </div>

        <div class="flex flex-col md:flex-row items-center gap-4">
          <div class="flex items-center gap-3">
            <a
              href="https://www.linkedin.com/company/health-integrity-project"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-primary transition-colors"
              aria-label="Visit us on LinkedIn"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
            <a
              href="https://www.instagram.com/health.integrity.project"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-primary transition-colors"
              aria-label="Follow us on Instagram"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd"/>
              </svg>
            </a>
          </div>

          <nav class="flex items-center gap-4 text-sm">
            <a
              href="https://healthintegrityproject.org/legal"
              target="_blank"
              rel="noopener noreferrer"
              class="text-muted-foreground hover:text-primary underline"
            >Terms & Privacy</a>
            <a
              href="mailto:hello@healthintegrityproject.org"
              class="text-muted-foreground hover:text-primary underline"
            >Contact</a>
          </nav>
        </div>
      </div>
    </footer>
  </body>
</html>
