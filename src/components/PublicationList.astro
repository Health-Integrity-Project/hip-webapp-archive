---
import { marked } from 'marked';
import type { Publication, PublicationScore, ExpertProfile } from '../lib/types';

interface Props {
  publications: Publication[];
  scores: PublicationScore[];
  experts: ExpertProfile[];
  stanceColor: 'teal' | 'orange' | 'gray';
  label: string;
  sectionId: string;
}

const { publications, scores, experts, stanceColor, label, sectionId } = Astro.props;

const colors = {
  teal:   { bar: 'bg-teal-500',   badge: 'bg-teal-500 text-white',   hover: 'hover:text-teal-600',   borderL: 'border-l-teal-500' },
  orange: { bar: 'bg-orange-500', badge: 'bg-orange-500 text-white', hover: 'hover:text-orange-600', borderL: 'border-l-orange-500' },
  gray:   { bar: 'bg-gray-400',   badge: 'bg-gray-400 text-white',   hover: 'hover:text-gray-600',   borderL: 'border-l-gray-400' },
}[stanceColor];

function scoresFor(pubId: string): PublicationScore[] {
  return scores.filter((s) => s.publication_id === pubId);
}

function expertFor(userId: string): ExpertProfile | undefined {
  return experts.find((e) => e.user_id === userId);
}

function stanceBorderClass(stance: string | null): string {
  switch (stance) {
    case 'supporting':    return 'border-l-teal-500';
    case 'contradicting': return 'border-l-orange-500';
    default:              return 'border-l-gray-400';
  }
}

// Get latest reviewer insight comment for a pub
function getReviewerInsight(pubScores: PublicationScore[]): { content: string; reviewedAt: string | null } | null {
  const withComments = pubScores
    .filter((s) => s.comments)
    .sort((a, b) => {
      const aT = a.updated_at ? new Date(a.updated_at).getTime() : 0;
      const bT = b.updated_at ? new Date(b.updated_at).getTime() : 0;
      return bT - aT;
    });
  if (withComments.length === 0) return null;
  const row = withComments[0];
  return { content: row.comments!, reviewedAt: row.updated_at ?? row.created_at ?? null };
}

// Derive study type badge from review_data
function getStudyTags(pubScores: PublicationScore[]): string[] {
  const tags = new Set<string>();
  for (const s of pubScores) {
    const rd = s.review_data as Record<string, unknown> | null | undefined;
    if (!rd) continue;
    // tags array
    if (Array.isArray(rd.tags)) {
      for (const t of rd.tags as string[]) tags.add(t);
    }
    // category field
    if (typeof rd.category === 'string') tags.add(rd.category);
  }
  return Array.from(tags);
}

function formatReviewDate(iso: string | null): string {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('en-US', { month: 'numeric', day: 'numeric', year: 'numeric' });
}

const CATEGORY_COLORS: Record<string, { bg: string; text: string }> = {
  'misinformation':          { bg: '#e9724c', text: '#ffffff' },
  'invalid':                 { bg: '#e5e7eb', text: '#374151' },
  'inconclusive':            { bg: '#e5e7eb', text: '#374151' },
  'not tested in humans':    { bg: '#fed7aa', text: '#374151' },
  'limited tested in humans':{ bg: '#bee9e8', text: '#1e40af' },
  'tested in humans':        { bg: '#0496ff', text: '#ffffff' },
  'widely tested in humans': { bg: '#0496ff', text: '#ffffff' },
  'women not included':      { bg: '#fed7aa', text: '#374151' },
  'observational':           { bg: '#bee9e8', text: '#1e40af' },
  'clinical trial':          { bg: '#0496ff', text: '#ffffff' },
};

function tagStyle(tag: string): string {
  const key = tag.trim().toLowerCase().replace(/\s+/g, ' ');
  const c = CATEGORY_COLORS[key];
  if (!c) return 'background:#6b7280;color:#ffffff';
  return `background:${c.bg};color:${c.text}`;
}
---

<section aria-label={label}>
  <!-- Collapsible header -->
  <button
    type="button"
    class="flex items-center gap-3 text-xl font-bold w-full text-left mb-5 group"
    aria-expanded="true"
    aria-controls={sectionId}
    onclick={`
      const btn = this;
      const content = document.getElementById('${sectionId}');
      const chevron = btn.querySelector('.chevron');
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      content.hidden = expanded;
      chevron.style.transform = expanded ? 'rotate(-90deg)' : 'rotate(0deg)';
    `}
  >
    <span class={`w-1 self-stretch rounded-full ${colors.bar} inline-block`} aria-hidden="true"></span>
    <span>{label}</span>
    <span class={`inline-flex items-center justify-center min-w-[1.75rem] h-7 rounded-full ${colors.badge} text-sm font-semibold px-2`}>
      {publications.length}
    </span>
    <svg class="chevron w-5 h-5 ml-auto text-gray-400 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div id={sectionId}>
    <ul class="space-y-4">
      {publications.map((pub) => {
        const pubScores = scoresFor(pub.id);
        const hasReviews = pubScores.length > 0;
        const reviewerInsight = getReviewerInsight(pubScores);
        const studyTags = getStudyTags(pubScores);
        const reviewerExperts = pubScores
          .map((s) => expertFor(s.expert_user_id))
          .filter((e): e is ExpertProfile => !!e);
        const uniqueExperts = Array.from(new Map(reviewerExperts.map((e) => [e.user_id, e])).values());

        return (
          <li class={`bg-white border border-gray-200 border-l-4 ${stanceBorderClass(pub.stance)} rounded-lg p-4 sm:p-5 shadow-sm`}>

            {/* Badges row */}
            <div class="flex flex-wrap gap-2 mb-3">
              {studyTags.map((tag) => (
                <span class="inline-flex items-center rounded-md px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide" style={tagStyle(tag)}>
                  {tag}
                </span>
              ))}
              {!hasReviews && (
                <span class="inline-flex items-center gap-1 rounded-md bg-amber-100 text-amber-800 border border-amber-300 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide">
                  <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  Awaiting Review
                </span>
              )}
            </div>

            {/* Title */}
            <p class="text-sm sm:text-base text-gray-700 leading-snug mb-2">
              {pub.title}
            </p>

            {/* Date */}
            {pub.publication_year && (
              <div class="flex items-center gap-1 text-xs text-gray-400 mb-3">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                <span>Published {pub.publication_year}</span>
              </div>
            )}

            {/* Reviewer Insight callout */}
            {reviewerInsight && (
              <div class="bg-blue-50 border-l-4 border-blue-400 rounded-r-md p-3 mb-4">
                <div class="flex items-center justify-between gap-1.5 mb-1.5">
                  <div class="flex items-center gap-1.5">
                    <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="text-xs font-bold uppercase tracking-wider text-blue-600">Reviewer Insight</span>
                  </div>
                  {reviewerInsight.reviewedAt && (
                    <div class="flex items-center gap-1 text-xs text-blue-500">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                      </svg>
                      <span>{formatReviewDate(reviewerInsight.reviewedAt)}</span>
                    </div>
                  )}
                </div>
                <div class="text-sm text-gray-700 leading-relaxed reviewer-markdown" set:html={marked.parse(reviewerInsight.content)} />
              </div>
            )}

            {/* Bottom row: expert avatars + Read Full Paper */}
            <div class="flex items-center justify-between mt-2">
              <div class="flex items-center gap-2">
                {uniqueExperts.length > 0 && (
                  <div class="flex -space-x-2">
                    {uniqueExperts.slice(0, 3).map((expert) => (
                      expert.avatar_url ? (
                        <img
                          src={expert.avatar_url}
                          alt={expert.display_name ?? 'Reviewer'}
                          class="w-8 h-8 rounded-full border-2 border-white object-cover"
                        />
                      ) : (
                        <div class="w-8 h-8 rounded-full border-2 border-white bg-blue-100 flex items-center justify-center text-xs font-semibold text-blue-600">
                          {(expert.display_name ?? '?').charAt(0).toUpperCase()}
                        </div>
                      )
                    ))}
                  </div>
                )}
                {uniqueExperts.length > 3 && (
                  <span class="text-sm text-gray-400 font-medium">+{uniqueExperts.length - 3}</span>
                )}
              </div>

              {(pub.url || pub.doi) && (
                <a
                  href={pub.url ?? `https://doi.org/${pub.doi}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:underline"
                >
                  Read Full Paper
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                  </svg>
                </a>
              )}
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  :global(.reviewer-markdown p) { margin-bottom: 0.5rem; }
  :global(.reviewer-markdown p:last-child) { margin-bottom: 0; }
  :global(.reviewer-markdown ul, .reviewer-markdown ol) { margin-left: 1.25rem; margin-bottom: 0.5rem; }
  :global(.reviewer-markdown ul) { list-style-type: disc; }
  :global(.reviewer-markdown ol) { list-style-type: decimal; }
  :global(.reviewer-markdown li) { margin-bottom: 0.25rem; }
  :global(.reviewer-markdown strong) { font-weight: 600; }
  :global(.reviewer-markdown em) { font-style: italic; }
  :global(.reviewer-markdown code) { background: #dbeafe; color: #1e40af; padding: 0.1rem 0.3rem; border-radius: 0.25rem; font-size: 0.8em; }
</style>
